[Unit]
Description=AeroShell PolicyKit Authentication Agent
PartOf=graphical-session.target
After=plasma-core.target
Conflicts=plasma-polkit-agent.target
	
[Service]
ExecStart=@KDE_INSTALL_FULL_LIBEXECDIR@/uac-polkit-agent
BusName=org.kde.polkit-kde-authentication-agent-1
Slice=background.slice
TimeoutStopSec=5sec
Restart=on-failure
Environment="USE_UAC_AGENT=1"